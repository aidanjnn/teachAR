# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo
.vite/

# Secrets; keep the documented example trackable
.env
.env.*
!.env.example
*.keystore
*.jks

# Private runtime data and captures; approve real fixtures individually
/data/
/recordings/
/captures/
*.log
logs/
traces/

# Test output
coverage/
playwright-report/
test-results/

# Local agent settings and OS files
.claude/settings.local.json
.DS_Store

# Local artifacts and Python caches
/artifacts/
__pycache__/
*.pyc

# Retired local GitHub runner; configuration can contain credentials.
/actions-runner/

# Upgrading leaves ignored local files behind when tracked sources move or retire.
# Keep old keys, camera caches, recordings and environments out of future commits.
/experiments/quest-browser/
/apps/quest/
