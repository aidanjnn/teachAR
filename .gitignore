# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo
.vite/

# Secrets; keep the documented example trackable
.env
.env.*
!.env.example

# Private runtime data and captures; approve real fixtures individually
/data/
/recordings/
/captures/
*.log
logs/
traces/

# Test output
coverage/
playwright-report/
test-results/

# Local agent settings and OS files
.claude/settings.local.json
.DS_Store

# Unity caches, local settings and build outputs; retain Assets .meta and UPM locks
/apps/quest/[Ll]ibrary/
/apps/quest/[Tt]emp/
/apps/quest/[Oo]bj/
/apps/quest/[Ll]ogs/
/apps/quest/[Uu]ser[Ss]ettings/
/apps/quest/[Bb]uild/
/apps/quest/[Bb]uilds/
/apps/quest/MemoryCaptures/
/apps/quest/Recordings/
/apps/quest/.vs/
/apps/quest/.utmp/
/apps/quest/*.csproj
/apps/quest/*.sln
/apps/quest/*.slnx
/apps/quest/*.user
/artifacts/
*.keystore
*.jks

# Portable native diagnostic outputs
/tests/native-network/bin/
/tests/native-network/obj/

# Meta editor-generated local AgentBridge settings may contain a machine credential.
/apps/quest/Assets/Resources/DevAgentSettings.asset
/apps/quest/Assets/Resources/DevAgentSettings.asset.meta
/apps/quest/Assets/Resources/OVRPlatformToolSettings.asset
/apps/quest/Assets/Resources/OVRPlatformToolSettings.asset.meta
# Generated by the Android build (Meta performance tooling and OpenXR bindings).
# They reappear on every build without .meta siblings and must not be committed.
/apps/quest/Assets/Resources/PerformanceTestRun*.json
/apps/quest/Assets/Resources/PerformanceTestRun*.json.meta
/apps/quest/Assets/StreamingAssets/
/apps/quest/Assets/StreamingAssets.meta

# Python native-CI verifier test caches
__pycache__/

# Retired local GitHub runner; configuration can contain credentials.
/actions-runner/
