{
  "name": "@trail/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tools/tsconfig.json",
    "test:native": "cd ../.. && tsx packages/contracts/tools/test-native.ts",
    "test:unity-isolated": "cd ../.. && tsx packages/contracts/tools/test-unity-isolated.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
