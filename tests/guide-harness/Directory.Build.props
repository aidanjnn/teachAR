<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <BaseOutputPath>../../artifacts/guide-harness/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>../../artifacts/guide-harness/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
