# Server only. Defaults are usable without credentials.
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
# mock (default, no key needed) or openai (needs OPENAI_API_KEY; enables transcription, labels, and the GPT-Live coach)
AI_PROVIDER=mock
HAPTICS_DRIVER=mock
BUILD_ID=development-uncommitted
# OpenAI is used when AI_PROVIDER=openai; OMNI/haptics keys below are reserved for later tickets.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TEXT_MODEL=gpt-4.1-mini-2025-04-14
LIVE_PROVIDER=mock
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-luna
OPENAI_LIVE_VOICE=marin
OPENAI_VISION_MODEL=gpt-6-astra
SCENE_SOURCE=mock
OMNI_API_KEY=
OMNI_BASE_URL=
OMNI_MODEL=
# Browser Sentry is configured separately in experiments/quest-browser/.env.example.
# This main server does not consume Sentry variables. See docs/sentry-observability.md.
HAPTICS_SERIAL_PORT=
DEMO_PAIRING_SECRET=

# Vision skeleton: pnpm dev generates an ephemeral service token if blank.
# Separate terminals: supply the same random >=32-character base64url token to both services.
VISION_HOST=127.0.0.1
VISION_PORT=3002
VISION_PROVIDER=mock
VISION_SERVICE_URL=
VISION_SERVICE_TOKEN=
# Reserved; no provider calls or native Live transport exist yet.
OPENAI_VISION_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_LIVE_MODEL=gpt-live-1

# Authoring/storage pairing. Production requires actual TLS and exact browser origins.
PAIRING_ORIGINS=
TLS_CERT_FILE=
TLS_KEY_FILE=
# Explicit local USB-loopback development only. Set true with a loopback browser Origin.
ALLOW_USB_LOOPBACK=false
