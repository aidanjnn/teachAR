# Server only. Defaults are usable without credentials.
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
# mock (default, no key needed) or openai (needs OPENAI_API_KEY; enables transcription, labels, and the GPT-Live coach)
AI_PROVIDER=mock
HAPTICS_DRIVER=mock
BUILD_ID=development-uncommitted
# OpenAI is used when AI_PROVIDER=openai; the OMNI keys below drive the scene coach when SCENE_COACH=omni; haptics keys are reserved for later tickets.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TEXT_MODEL=gpt-4.1-mini-2025-04-14
LIVE_PROVIDER=mock
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-luna
OPENAI_LIVE_VOICE=marin
# on: the coach says one short line when a live session opens (audio check before AR). off: silent until asked.
OPENAI_LIVE_GREETING=on
OPENAI_VISION_MODEL=gpt-6-astra
SCENE_SOURCE=mock
# Scene coach (Huawei OMNI Live track): Look & advise sends a fresh camera frame, the step's reference photo and a question
# to an OMNI multimodal model through the yibuapi OpenAI-compatible gateway; speech comes back. Off by default. The key stays here.
SCENE_COACH=off
OMNI_API_KEY=
OMNI_BASE_URL=https://yibuapi.com/v1
OMNI_MODEL=qwen3.5-omni-flash
OMNI_VOICE=Cherry
# Public browser Sentry configuration, served by either tutor server.
# Python startup uses exported environment variables; see apps/webxr/.env.example.
SENTRY_ENABLED=false
SENTRY_BROWSER_DSN=
SENTRY_REPLAY_ENABLED=false
SENTRY_ENVIRONMENT=hackathon-demo
SENTRY_RELEASE=trail-browser@development
SENTRY_TRACES_SAMPLE_RATE=1
HAPTICS_SERIAL_PORT=
DEMO_PAIRING_SECRET=

# Vision skeleton: pnpm dev:desktop generates an ephemeral service token if blank.
# Separate terminals: supply the same random >=32-character base64url token to both services.
VISION_HOST=127.0.0.1
VISION_PORT=3002
VISION_PROVIDER=mock
VISION_SERVICE_URL=
VISION_SERVICE_TOKEN=
# Reserved; no provider calls or native Live transport exist yet.
OPENAI_VISION_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_LIVE_MODEL=gpt-live-1

# Authoring/storage pairing. Production requires actual TLS and exact browser origins.
# For the Quest Browser tutor over USB: ALLOW_USB_LOOPBACK=true and PAIRING_ORIGINS=http://localhost:3001
PAIRING_ORIGINS=
TLS_CERT_FILE=
TLS_KEY_FILE=
# Explicit local USB-loopback development only. Set true with a loopback browser Origin.
ALLOW_USB_LOOPBACK=false
