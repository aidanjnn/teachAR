{
  "name": "trail",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "pnpm build:shared && tsx scripts/dev.ts",
    "build:shared": "pnpm --filter @trail/contracts build && pnpm --filter @trail/motion build",
    "dev:shared": "concurrently -k \"pnpm --filter @trail/contracts dev\" \"pnpm --filter @trail/motion dev\"",
    "build": "pnpm build:shared && pnpm --filter @trail/web build && pnpm --filter @trail/server build && pnpm --filter @trail/vision build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm check:quest-scaffold",
    "start": "node apps/server/dist/main.js",
    "validate:fixtures": "pnpm build:shared && tsx scripts/validate-fixtures.ts",
    "dev:web": "pnpm build:shared && concurrently -k -n shared,web,server \"pnpm dev:shared\" \"pnpm --filter @trail/web dev\" \"pnpm --filter @trail/server dev\"",
    "start:vision": "node apps/vision/dist/main.js",
    "check:quest-scaffold": "tsx scripts/check-quest-scaffold.ts",
    "quest:test": "tsx scripts/quest.ts test",
    "quest:setup": "tsx scripts/quest.ts setup",
    "quest:test:play": "tsx scripts/quest.ts test-play",
    "quest:build": "tsx scripts/quest.ts build",
    "test:native-network": "dotnet run --project tests/native-network/Network.csproj"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "concurrently": "9.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
