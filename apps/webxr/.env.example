# Optional Sentry configuration for the Quest Browser tutor (Python server).
# Copy to .env, edit the values, then explicitly load it before starting:
#   . ./.env
#   sh start.sh
# The server does not automatically read .env. Restart after changing values.
# This is a PUBLIC browser DSN, never a Sentry authentication token.
export SENTRY_ENABLED=false
export SENTRY_BROWSER_DSN=''
export SENTRY_REPLAY_ENABLED=false
export SENTRY_ENVIRONMENT=hackathon-demo
export SENTRY_RELEASE=trail-browser@development
export SENTRY_TRACES_SAMPLE_RATE=1
